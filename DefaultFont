/* Futura PT Regular */
@font-face {
  font-family: "Futura PT";
  src: url("https://github.com/local12775/fonts/raw/refs/heads/main/F011003T.woff2") format("woff2"),
       url("https://github.com/local12775/fonts/raw/refs/heads/main/F011003T.woff") format("woff");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

/* Force all Kintone text to use it */
html, body, * {
  font-family: "Futura PT", "Segoe UI", Arial, sans-serif !important;
}

input, textarea, select, button {
  font-family: inherit !important;
}
